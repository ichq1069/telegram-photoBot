# Telegram PhotoBot Manager 环境变量配置
# 复制此文件为 .env 并修改实际值

# 安全密钥 (生产环境请务必修改为随机字符串)
SECRET_KEY=change-me-in-production-please

# Telegram API 模式: official / self_build
TG_API_MODE=official
TG_SELF_BUILD_API_URL=
TG_SELF_BUILD_API_KEY=

# MySQL 远程数据库配置 (可选, 用于容灾备份)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=photobot

# 数据库同步间隔 (分钟)
SYNC_INTERVAL_MINUTES=60

# 上传配置
UPLOAD_MAX_SIZE_MB=20
COMPRESS_ENABLED=true
COMPRESS_QUALITY=85

# 日志级别: DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
